# Copy to .env (never committed) and adjust.
BABEL_ENVIRONMENT=development
BABEL_LOG_LEVEL=INFO
# Origins allowed for the web app (JSON list)
BABEL_CORS_ORIGINS=["http://localhost:8080"]
# Local development uses SQLite; the server uses PostgreSQL (see infra/docker-compose.yml).
BABEL_DATABASE_URL=sqlite+aiosqlite:///./babel.db
# Required in production: a random value, e.g. `openssl rand -base64 48`.
BABEL_JWT_SECRET=
# Plain-HTTP local development only: allow the refresh cookie without HTTPS.
BABEL_COOKIE_SECURE=false
# Social sign-in: OAuth client IDs accepted as token audience (JSON lists). Empty = disabled.
BABEL_GOOGLE_CLIENT_IDS=[]
BABEL_APPLE_CLIENT_IDS=[]
# Address of the web app, used in emailed links.
BABEL_PUBLIC_URL=http://localhost:8080
# Outgoing email. Without BABEL_SMTP_HOST, emails are written to the log instead.
BABEL_SMTP_HOST=
BABEL_SMTP_PORT=587
BABEL_SMTP_USERNAME=
BABEL_SMTP_PASSWORD=
BABEL_MAIL_FROM=Babel <contact@jouskaio.me>
# Book files (ADR 0010): storage folder, download policy (everyone | entitled), upload cap.
BABEL_FILES_DIR=./data/files
BABEL_FILE_ACCESS=everyone
BABEL_MAX_UPLOAD_MB=300
# Administrators (file withdrawal), as a JSON list of emails.
BABEL_ADMIN_EMAILS=[]
# Sources (ADR 0009): Fernet key encrypting access tokens (empty: public sources only),
# generated with: openssl rand -base64 32 | tr '+/' '-_'
BABEL_SECRETS_KEY=
BABEL_MAX_SOURCES_PER_USER=20
# Private-network hosts OPDS/WebDAV sources may reach (home Calibre-Web, Nextcloud…).
BABEL_SOURCE_ALLOWED_HOSTS=[]
# Unfinished AO3 works imported by link are checked for new chapters every N hours (0: off).
BABEL_FOLLOW_INTERVAL_HOURS=24
# Firebase service account JSON for push notifications (new chapters). Empty: logged only.
BABEL_FCM_CREDENTIALS_FILE=
