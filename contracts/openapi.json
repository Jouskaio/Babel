          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "IdentityProvider": {
        "description": "External identity providers a user can sign in with.",
        "enum": [
          "google",
          "apple"
        ],
        "title": "IdentityProvider",
        "type": "string"
      },
      "IsbnLookupResponse": {
