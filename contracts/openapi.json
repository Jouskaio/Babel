          },
          "editions": {
            "items": {
              "$ref": "#/components/schemas/EditionResponse"
            },
            "title": "Editions",
            "type": "array"
          },
          "first_publish_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
