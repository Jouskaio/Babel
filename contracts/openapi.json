          "password",
          "display_name"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "ResetPasswordRequest": {
        "description": "``token`` comes from the link sent by email.",
        "properties": {
          "new_password": {
            "maxLength": 128,
            "minLength": 10,
            "title": "New Password",
            "type": "string"
          },
          "token": {
