          "apple": {
            "title": "Apple",
            "type": "boolean"
          },
          "google": {
            "title": "Google",
            "type": "boolean"
          },
          "password": {
            "default": true,
            "title": "Password",
            "type": "boolean"
          }
        },
        "required": [
          "google",
          "apple"
        ],
        "title": "ProvidersResponse",
        "type": "object"
      },
      "RefreshRequest": {
        "description": "Mobile apps send the token in the body; the web app relies on the cookie.",
        "properties": {
          "refresh_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refresh Token"
          }
        },
        "title": "RefreshRequest",
        "type": "object"
      },
      "RegisterRequest": {
        "properties": {
          "display_name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "locale": {
            "anyOf": [
              {
                "enum": [
                  "fr",
                  "en"
