            "title": "First Publish Year"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "original_title": {
            "title": "Original Title",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "original_title",
          "authors",
          "first_publish_year",
          "cover_path",
          "edition_count",
          "description",
