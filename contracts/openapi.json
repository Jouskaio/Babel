          }
        },
        "required": [
          "edition_id",
          "work"
        ],
        "title": "IsbnLookupResponse",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "ProviderLoginRequest": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "id_token": {
            "title": "Id Token",
            "type": "string"
          },
          "nonce": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nonce"
          }
        },
        "required": [
          "id_token"
        ],
        "title": "ProviderLoginRequest",
        "type": "object"
      },
      "ProvidersResponse": {
        "description": "Sign-in methods enabled on this server.",
