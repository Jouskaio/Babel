{
  "components": {
    "schemas": {
      "ChangePasswordRequest": {
        "description": "``current_password`` is required unless the account has no password yet.",
        "properties": {
          "current_password": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Password"
          },
          "new_password": {
            "maxLength": 128,
            "minLength": 10,
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "new_password"
        ],
        "title": "ChangePasswordRequest",
        "type": "object"
      },
      "EditionResponse": {
        "properties": {
          "cover_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cover Path"
          },
          "format": {
